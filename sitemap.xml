---
permalink: /sitemap.xml
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:xhtml="http://www.w3.org/1999/xhtml">
{%- for page in site.pages -%}
{%- if page.permalink and page.layout and page.layout != "null" %}
  <url>
    <loc>{{ page.url | absolute_url }}</loc>
    {%- if page.page_key %}
    {%- assign url_key = page.page_key | append: "_url" %}
    {%- for lang in site.languages %}
    {%- assign d = site.data[lang] %}
    <xhtml:link rel="alternate" hreflang="{{ d.locale_tag }}" href="{{ d[url_key] | absolute_url }}"/>
    {%- for extra in d.hreflang_alt %}
    <xhtml:link rel="alternate" hreflang="{{ extra }}" href="{{ d[url_key] | absolute_url }}"/>
    {%- endfor %}
    {%- endfor %}
    <xhtml:link rel="alternate" hreflang="x-default" href="{{ site.data[site.default_lang][url_key] | absolute_url }}"/>
    {%- endif %}
    <changefreq>monthly</changefreq>
  </url>
{%- endif -%}
{%- endfor %}
</urlset>
